# Copy to .env (gitignored). Read by `adk deploy agent_engine` and run_demo.sh.
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=indoc-511303
# Regional endpoint only: the global endpoint gives no data-residency guarantee.
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Public MCP endpoint (tunnel exposes only /mcp).
INDOC_MCP_URL=https://research.sharedoxygen.com/mcp
