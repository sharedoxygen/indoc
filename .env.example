# inDoc Environment Configuration Template
# Copy this file to .env and customize with your actual values
# NEVER commit .env to git!

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=indoc
POSTGRES_USER=indoc_user
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# Security - CRITICAL: Generate secure random values!
JWT_SECRET_KEY=GENERATE_64_CHAR_RANDOM_STRING
FIELD_ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY

# OpenAI (Optional Fallback)
# OPENAI_API_KEY=sk-your-key-here

# S3 (Optional)
# S3_ACCESS_KEY_ID=YOUR_KEY
# S3_SECRET_ACCESS_KEY=YOUR_SECRET

# DO NOT USE REAL CREDENTIALS IN THIS FILE!
