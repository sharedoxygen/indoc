# inDoc Environment Configuration Template
# Copy this file to .env and customize with your actual values
# NEVER commit .env to git!

# External shared data plane (NOT in Docker Compose).
# Swap hosts to scale onto cloud managed services without changing the app stack:
#   local:  localhost / host.docker.internal
#   cloud:  *.rds.amazonaws.com, *.cache.amazonaws.com, Cloud SQL, Memorystore, …
# Bootstrap local isolation: make db-isolate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=indoc
POSTGRES_USER=indoc_user
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# Dedicated Redis logical DB (local multi-tenant host) — use a dedicated
# ElastiCache/Memorystore instance (or ACL user) in cloud instead of /2 if preferred.
REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security - CRITICAL: Generate secure random values!
JWT_SECRET_KEY=GENERATE_64_CHAR_RANDOM_STRING
FIELD_ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY

# OpenAI (Optional Fallback)
# OPENAI_API_KEY=sk-your-key-here

# S3 (Optional)
# S3_ACCESS_KEY_ID=YOUR_KEY
# S3_SECRET_ACCESS_KEY=YOUR_SECRET

# DO NOT USE REAL CREDENTIALS IN THIS FILE!
